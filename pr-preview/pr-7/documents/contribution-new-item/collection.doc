  <div class="Abstract"><a name="_9596c6de-77ea-9d34-d4c8-0d4ceea6f2d6_ITU_G.650" id="_9596c6de-77ea-9d34-d4c8-0d4ceea6f2d6_ITU_G.650"></a>
    <p class="h1Preface">Summary</p>
    <p class="MsoNormal"><a name="_c837253e-ba91-1b74-94f7-800f976182e3_ITU_G.650" id="_c837253e-ba91-1b74-94f7-800f976182e3_ITU_G.650"></a>The summary goes here.</p>
  </div>
  <div class="Keyword"><a name="_edb536f0-ed1b-fc5a-63cf-bc87c61db4e8_ITU_G.650" id="_edb536f0-ed1b-fc5a-63cf-bc87c61db4e8_ITU_G.650"></a>
